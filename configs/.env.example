# Aperture configuration (environment variables). Copy to deploy/.env or export.

# HTTP listen address for the web UI + API.
APERTURE_HTTP_ADDR=":8080"

# Where SQLite, secrets, and runtime config live.
APERTURE_DATA_DIR="./data"

# Where recorded video segments are written.
APERTURE_RECORDINGS_DIR="./recordings"

# go2rtc endpoints (internal). The browser/HA never see camera RTSP credentials.
APERTURE_GO2RTC_URL="http://localhost:1984"
APERTURE_GO2RTC_RTSP="rtsp://localhost:8554"

# MQTT broker for Home Assistant auto-discovery (optional; leave empty to disable).
APERTURE_MQTT_URL="tcp://localhost:1883"

# Public base URL used when building stream URLs handed to browsers / Home Assistant.
APERTURE_PUBLIC_URL="http://localhost:8080"

# Secrets — leave unset to auto-generate and persist under APERTURE_DATA_DIR/secrets.json.
# APERTURE_JWT_SECRET=""
# APERTURE_STREAM_SECRET=""

# In local dev (frontend served by vite), point nvrd at the built assets on disk
# instead of the embedded bundle. Leave unset in production.
# APERTURE_WEB_DIR="./web/dist"
