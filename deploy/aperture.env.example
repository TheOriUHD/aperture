# Aperture daemon environment. Installed to /etc/aperture/aperture.env.
#
# Only settings that must exist BEFORE the database opens live here; everything
# else is configured in the app. install.sh seeds this file once and never
# overwrites it, so local edits survive upgrades.
#
# Every key below was verified against internal/config/config.go — the value in
# parentheses is that file's built-in default.

# Listen address for the web UI + API. Native installs have no port mapping, so
# this is the real port the LAN and the reverse proxy connect to. (":8080")
APERTURE_HTTP_ADDR=":8971"

# State and footage. The defaults are relative paths meant for `make run` in a
# checkout; a service install must set both absolutely. ("./data", "./recordings")
# These two MUST NOT NEST: the janitor treats dirBytes(APERTURE_DATA_DIR) as the
# app's own footprint and subtracts it from the storage cap. Nesting recordings
# inside the data dir makes the cap target negative and the janitor deletes every
# recording on its first pass.
APERTURE_DATA_DIR="/var/lib/aperture/data"
APERTURE_RECORDINGS_DIR="/var/lib/aperture/recordings"

# go2rtc runs as its own unit on localhost. Under Docker these named
# host.docker.internal, which does not exist off Docker — hence 127.0.0.1.
# ("http://localhost:1984", "rtsp://localhost:8554")
APERTURE_GO2RTC_URL="http://127.0.0.1:1984"
APERTURE_GO2RTC_RTSP="rtsp://127.0.0.1:8554"

# The LAN address EXTERNAL consumers (VLC, Home Assistant, a VMS) use to reach
# go2rtc's RTSP/snapshot ports. Required whenever Aperture is opened through a
# reverse proxy: the proxy forwards the web UI but NOT the raw RTSP port, so the
# advertised rtsp:// URL must name this address. Empty = use the host the UI was
# opened on, which is only correct for direct-IP access. ("")
APERTURE_STREAM_HOST=""

# Public base URL used to build stream URLs handed to browsers and Home
# Assistant. ("http://localhost:8080")
APERTURE_PUBLIC_URL="http://localhost:8971"

# Local MQTT broker for the Home Assistant integration. Empty disables it. ("")
APERTURE_MQTT_URL="tcp://127.0.0.1:1883"

# So a root `nvrctl` on this host reaches the API without --url.
APERTURE_URL="http://127.0.0.1:8971"

# Vendored runtime. The unit's PATH already prefers /usr/lib/aperture/bin for
# bare `ffmpeg`/`ffprobe`; these two are looked up by absolute path instead.
APERTURE_DENO_PATH="/usr/lib/aperture/bin/deno"
# NOTE: --allow-read grants an extension this file's WHOLE PARENT DIRECTORY
# (internal/ext/spec.go), which is why the SDK gets a directory of its own with
# exactly one file in it. aperture-harden refuses to start if that stops being true.
APERTURE_EXT_SDK="/usr/lib/aperture/sdk/mod.ts"

# Host-network interop, finally possible off the Docker bridge. Both default to
# false; enable them in the app (Settings → Interop) or force them here.
#APERTURE_HOMEKIT_ENABLED="true"
#APERTURE_ONVIF_ENABLED="true"

# mDNS/DNS-SD advertisement, read by aperture-discovery.service.
# ("Aperture NVR", "aperture", "8971")
APERTURE_ADVERTISE_NAME="Aperture NVR"
APERTURE_ADVERTISE_HOST="aperture"
APERTURE_ADVERTISE_PORT="8971"
# Comma-separated interface allowlist. Leave unset to auto-select LAN interfaces.
#APERTURE_ADVERTISE_IFACE="ens18"
