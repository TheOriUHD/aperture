# Copy to deploy/.env to override defaults for `docker compose` / `make up`.

# Host port the web UI + API are published on (container stays on 8080 internally).
APERTURE_PORT=8971

# Public base URL used when building stream URLs handed to browsers / Home Assistant.
# Set this to how clients actually reach the server, e.g. http://192.168.1.50:8971
APERTURE_PUBLIC_URL=http://localhost:8971
