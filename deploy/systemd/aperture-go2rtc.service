[Unit]
Description=go2rtc (Aperture stream broker)
Documentation=https://github.com/AlexxIT/go2rtc
After=network-online.target
Wants=network-online.target
# Only honoured in [Unit]; in [Service] systemd ignores it. Without it the
# default 5-starts-per-10s limit would leave the broker permanently dead.
StartLimitIntervalSec=0

[Service]
Type=exec
# go2rtc rewrites this file when nvrd PUTs streams, so it lives in state, not /etc.
ExecStart=/usr/lib/aperture/bin/go2rtc -config /var/lib/aperture/go2rtc.yaml
Restart=always
RestartSec=2

User=aperture-go2rtc
Group=aperture-go2rtc

# Ports 1984/8554/8555 are all >1024, so no capabilities are needed.
NoNewPrivileges=yes
ProtectSystem=strict
# The config is rewritten at runtime; it also holds camera RTSP passwords (0600).
ReadWritePaths=/var/lib/aperture/go2rtc.yaml
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
