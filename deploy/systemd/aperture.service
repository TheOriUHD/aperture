[Unit]
Description=Aperture NVR daemon
Documentation=https://github.com/TheOriUHD/aperture
Wants=network-online.target aperture-go2rtc.service mosquitto.service
After=network-online.target aperture-go2rtc.service mosquitto.service
# An NVR must never be given up on. Without this, systemd's default rate limit
# (5 starts / 10s) turns a crash loop into a permanently dead unit, which would
# silently defeat Restart=always below. This key is only honoured in [Unit].
StartLimitIntervalSec=0

[Service]
Type=exec
EnvironmentFile=/etc/aperture/aperture.env
# The vendored runtime MUST win over any distro ffmpeg: internal/record/recorder.go:215,662
# invoke bare `ffmpeg`/`ffprobe` through PATH. Debian 13 ships ffmpeg 7.x while the recorder
# is validated against 5.1.9, and `-f segment` behaviour is what the whole timeline rests on.
Environment=PATH=/usr/lib/aperture/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/libexec/aperture/aperture-harden
ExecStart=/usr/bin/nvrd

# --- restart ---------------------------------------------------------------
# The in-app restart button calls os.Exit(0) 900ms after responding
# (internal/api/recordings_handlers.go:732-748) and relies on the supervisor to
# bring the daemon back. Restart=on-failure would treat that as a clean exit and
# leave the NVR down.
Restart=always
RestartSec=2
# NOTE: the rate-limit that would otherwise defeat Restart=always lives in
# [Unit] as StartLimitIntervalSec — systemd silently ignores it in [Service].

# --- shutdown --------------------------------------------------------------
# nvrd's ordered shutdown (cmd/nvrd/main.go, budget in cmd/nvrd/shutdown.go): extensions
# (5s+2s), then background services incl. every recorder ffmpeg closing its segment (20s),
# then HTTP (10s) => ~37s worst case, normally 1-2s. Keep this above that.
TimeoutStopSec=45
# 'mixed' = SIGTERM to nvrd alone so its ordered shutdown runs undisturbed, SIGKILL to
# the whole cgroup only at timeout. 'control-group' would signal ffmpeg and every
# extension in parallel, racing that ordering; 'process' would ORPHAN the recorders,
# which carry no Pdeathsig (internal/record/recorder.go:215).
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# --- resource limits: replaces compose mem_limit/pids_limit/cpus -----------
# Documented "Layer 2" containment for a runaway or escaped extension.
# These also bound nvrd's own ffmpeg workers, and the web server shares the limit
# with them: at the limit the API is throttled with everything else. Stream copy
# costs almost nothing, but a camera opted into a lower recording quality is
# software re-encoded (internal/record/quality.go), about 0.7 GB and 1.3 cores for a
# 4K camera. At 1800M/300% two such cameras pinned the service at its memory
# ceiling, 1.8 GB in swap and throttled 98% of the time, and the web app took
# seconds to show anything. Object recognition on an NVIDIA GPU adds about 1.1 GB
# (the CUDA worker, with the package model); at 3G/3.5G it reached the ceiling and
# began swapping, so the VM went to 8 GB and the limits to 4.5G/5G.
MemoryHigh=4608M
MemoryMax=5G
TasksMax=1024
CPUQuota=600%
LimitNOFILE=65536
# MANDATORY. Extensions carry a raised oom_score_adj so they die first under memory
# pressure (internal/ext/supervisor.go:406-414). systemd's default OOMPolicy=stop would
# take nvrd down WITH the extension it just sacrificed -- i.e. a leaking third-party
# extension would stop recording. This restores the intended behaviour.
OOMPolicy=continue

# --- sandboxing ------------------------------------------------------------
# NoNewPrivileges does NOT block the extension setuid drop: it prevents GAINING
# privilege across execve, while syscall.Credential is a root process DROPPING to
# uid 65600. It is required here because, unlike the slim container, a real host has
# setuid-root binaries an escaped extension could exec.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aperture
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# HomeKit/mDNS advertise the hostname, so this stays off.
ProtectHostname=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
#
# Deliberately NOT set, with reasons:
#   User=/DynamicUser=          nvrd must be root (setuid-drops children, chowns ext dirs)
#   PrivateUsers=yes            breaks chown to host uid 65600 -- extension isolation collapses
#   MemoryDenyWriteExecute=yes  Deno's V8 JIT needs W^X transitions
#   SystemCallFilter=           interaction with setresuid/setgroups/fchownat + Deno is not
#                               worth guessing during a migration; phase-2 hardening
#   CapabilityBoundingSet=      needs >= CAP_SETUID SETGID CHOWN FOWNER KILL DAC_OVERRIDE
#                               SYS_RESOURCE; trim later, gated on an extension test
#   WatchdogSec=                nvrd does not sd_notify

[Install]
WantedBy=multi-user.target
