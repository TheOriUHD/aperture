[Unit]
Description=Aperture mDNS/DNS-SD advertisement
After=network-online.target
Wants=network-online.target

# Same rate-limit caveat as the other units; must be in [Unit] to take effect.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/lib/aperture/bin/apdiscovery
EnvironmentFile=-/etc/aperture/aperture.env
Restart=always
RestartSec=5

# Stateless: no database handle, no credentials, no files. DynamicUser is free hardening.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_NETLINK is REQUIRED: net.Interfaces() (cmd/apdiscovery/main.go:37) enumerates
# NICs over netlink, and without it the call errors, lanInterfaces() returns nil and
# the responder advertises on no interface at all — logging "via []" and going
# silently undiscoverable, the same failure class fixed once already this month.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
